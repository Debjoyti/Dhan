// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  FARMER
  ADMIN
  DELIVERY_PARTNER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
}

enum FarmerVerificationStatus {
  PENDING
  DOCUMENTS_SUBMITTED
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  SEASONAL_UNAVAILABLE
  ARCHIVED
}

enum ProductUnit {
  KG
  GRAM
  PIECE
  DOZEN
  BUNDLE
  LITRE
  PACK
}

enum OrderStatus {
  CART
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  FARMER_ACCEPTED
  FARMER_REJECTED
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_INITIATED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  COD
}

enum DeliveryType {
  EXPRESS_SAME_DAY      // within 6 hours (near farms only)
  NEXT_DAY
  SCHEDULED             // customer picks a slot
  SUBSCRIPTION_AUTO     // recurring subscription delivery
}

enum SubscriptionFrequency {
  DAILY
  ALTERNATE_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum QualityGrade {
  A_PREMIUM            // hand-picked, perfect size/shape
  A_STANDARD           // good quality, minor variations
  B_ECONOMY            // slightly irregular, great for cooking
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_REPLACEMENT
  RESOLVED_NO_ACTION
  CLOSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  phone         String      @unique
  email         String?     @unique
  name          String?
  avatarUrl     String?
  role          UserRole
  status        UserStatus  @default(PENDING_VERIFICATION)
  fcmToken      String?     // for push notifications
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  farmer        Farmer?
  customer      Customer?
  deliveryPartner DeliveryPartner?
  sessions      Session[]
  otpVerifications OtpVerification[]
  notifications Notification[]
  addresses     Address[]

  @@index([phone])
  @@index([role, status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  deviceInfo Json?   // { device, os, app_version }
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([token])
}

model OtpVerification {
  id        String   @id @default(cuid())
  userId    String?
  phone     String
  otp       String
  purpose   String   // 'login', 'register', 'payment_confirm', 'payout_confirm'
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  @@index([phone, purpose])
}

// ─── FARMERS ─────────────────────────────────────────────────────────────────

model Farmer {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  farmName              String
  ownerName             String
  bio                   String?
  profileImageUrl       String?
  coverImageUrl         String?

  // Location
  village               String?
  taluka                String?
  district              String
  state                 String
  pincode               String
  lat                   Float?
  lng                   Float?
  farmSizeAcres         Float?

  // Farming details
  farmingType           String[]  // ['organic', 'natural', 'conventional']
  certifications        String[]  // ['organic_india', 'pgs_green', 'fssai']
  yearsOfExperience     Int?
  cropsGrown            String[]  // for discovery

  // Verification
  verificationStatus    FarmerVerificationStatus @default(PENDING)
  aadharNumber          String?                  // encrypted
  aadharVerified        Boolean                  @default(false)
  panNumber             String?                  // encrypted
  bankAccountNumber     String?                  // encrypted
  bankIfsc              String?
  bankAccountName       String?
  bankVerified          Boolean                  @default(false)
  fssaiLicense          String?

  // Business metrics
  totalOrders           Int       @default(0)
  totalRevenue          Float     @default(0)
  avgRating             Float?
  totalRatings          Int       @default(0)

  // Settings
  isAcceptingOrders     Boolean   @default(true)
  autoAcceptOrders      Boolean   @default(false)  // auto-confirm without manual approval
  minOrderValue         Float?
  maxOrdersPerDay       Int?
  deliveryRadius        Int?      // km — how far they can ship/allow pickup

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id])
  products              Product[]
  orders                Order[]   @relation("FarmerOrders")
  payouts               Payout[]
  reviews               FarmerReview[]
  farmPhotos            FarmPhoto[]
  badges                FarmerBadge[]
  whatsappConfig        FarmerWhatsappConfig?
  qualityReports        QualityReport[]

  @@index([district, state])
  @@index([verificationStatus])
  @@index([lat, lng])
}

model FarmPhoto {
  id          String   @id @default(cuid())
  farmerId    String
  url         String
  caption     String?
  isHero      Boolean  @default(false)
  uploadedAt  DateTime @default(now())
  farmer      Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
}

model FarmerBadge {
  id          String   @id @default(cuid())
  farmerId    String
  badge       String   // 'top_seller', 'organic_certified', 'on_time_delivery', 'customer_favorite'
  awardedAt   DateTime @default(now())
  farmer      Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
}

model FarmerWhatsappConfig {
  id              String  @id @default(cuid())
  farmerId        String  @unique
  phone           String  // WhatsApp phone (may differ from login phone)
  isEnabled       Boolean @default(true)
  notifyNewOrder  Boolean @default(true)
  notifyPayment   Boolean @default(true)
  notifyLowStock  Boolean @default(true)
  farmer          Farmer  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
}

model FarmerReview {
  id          String   @id @default(cuid())
  farmerId    String
  customerId  String
  orderId     String   @unique
  rating      Int      // 1-5
  comment     String?
  reply       String?  // farmer's reply
  photos      String[] // review photos
  isVerified  Boolean  @default(true) // verified purchase
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmer      Farmer   @relation(fields: [farmerId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])

  @@index([farmerId])
  @@index([customerId])
}

// ─── CUSTOMERS ───────────────────────────────────────────────────────────────

model Customer {
  id              String    @id @default(cuid())
  userId          String    @unique
  firstName       String?
  lastName        String?
  profileImageUrl String?
  dateOfBirth     DateTime?

  // Preferences
  dietaryPrefs    String[]  // ['vegetarian', 'vegan', 'organic_only']
  preferredCategories String[]

  // Loyalty
  loyaltyPoints   Int       @default(0)
  loyaltyTier     String    @default("seedling") // seedling, sprout, bloom, harvest

  // Stats
  totalOrders     Int       @default(0)
  totalSpent      Float     @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  orders          Order[]
  subscriptions   Subscription[]
  reviews         FarmerReview[]
  cart            Cart?
  wishlist        WishlistItem[]
  paymentMethods  SavedPaymentMethod[]
}

model Address {
  id              String    @id @default(cuid())
  userId          String
  label           String?   // 'Home', 'Office', 'Parents'
  recipientName   String
  phone           String
  addressLine1    String
  addressLine2    String?
  landmark        String?
  city            String
  state           String
  pincode         String
  lat             Float?
  lng             Float?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([userId])
  @@index([pincode])
}

model SavedPaymentMethod {
  id              String    @id @default(cuid())
  customerId      String
  type            String    // 'upi', 'card', 'wallet'
  label           String    // 'Google Pay', 'HDFC ****4521'
  token           String    // Razorpay token
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ─── PRODUCT CATALOG ─────────────────────────────────────────────────────────

model Category {
  id              String      @id @default(cuid())
  name            String      @unique
  slug            String      @unique
  description     String?
  iconUrl         String?
  imageUrl        String?
  parentId        String?
  sortOrder       Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())

  parent          Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]  @relation("CategoryHierarchy")
  products        Product[]
}

model Product {
  id              String        @id @default(cuid())
  farmerId        String
  categoryId      String

  name            String
  slug            String        @unique
  description     String?
  longDescription String?       // markdown

  // Pricing per quality grade
  pricePerUnit    Float         // base price (Grade A Standard)
  premiumPricePerUnit Float?    // Grade A Premium
  economyPricePerUnit Float?    // Grade B Economy
  mrp             Float?        // market reference price (to show savings)

  unit            ProductUnit
  minOrderQuantity Float        @default(0.5)
  maxOrderQuantity Float?

  // Availability
  status          ProductStatus @default(DRAFT)
  quantityAvailable Float       @default(0)
  nextAvailableDate DateTime?   // for seasonal produce

  // Quality & Origin
  qualityGrade    QualityGrade  @default(A_STANDARD)
  harvestDate     DateTime?
  bestBeforeDate  DateTime?
  originVillage   String?
  organicCertified Boolean     @default(false)

  // Media
  images          ProductImage[]

  // SEO & Discovery
  tags            String[]
  searchKeywords  String[]

  // Metrics
  totalOrders     Int           @default(0)
  totalQuantitySold Float       @default(0)
  avgRating       Float?
  totalRatings    Int           @default(0)

  // Delivery config
  shelfLifeDays   Int?          // used to determine delivery radius/speed
  requiresColdChain Boolean     @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  farmer          Farmer        @relation(fields: [farmerId], references: [id])
  category        Category      @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  cartItems       CartItem[]
  subscriptionItems SubscriptionItem[]
  wishlistItems   WishlistItem[]
  priceHistory    PriceHistory[]
  qualityReports  QualityReport[]

  @@index([farmerId, status])
  @@index([categoryId, status])
  @@index([slug])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  altText     String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  uploadedAt  DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  price       Float
  unit        ProductUnit
  reason      String?  // 'seasonal_adjustment', 'manual_change', 'festival_special'
  changedAt   DateTime @default(now())
  changedBy   String?  // admin or farmer userId

  product     Product  @relation(fields: [productId], references: [id])
  @@index([productId, changedAt])
}

model QualityReport {
  id              String    @id @default(cuid())
  productId       String
  farmerId        String
  orderId         String?
  reportedBy      String    // 'customer', 'delivery_partner', 'admin_qc'
  grade           QualityGrade
  issues          String[]  // ['overripe', 'underweight', 'damaged_packaging']
  photos          String[]
  notes           String?
  createdAt       DateTime  @default(now())

  product         Product   @relation(fields: [productId], references: [id])
  farmer          Farmer    @relation(fields: [farmerId], references: [id])
}

// ─── CART ────────────────────────────────────────────────────────────────────

model Cart {
  id              String      @id @default(cuid())
  customerId      String      @unique
  couponCode      String?
  discountAmount  Float       @default(0)
  updatedAt       DateTime    @updatedAt

  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           CartItem[]
}

model CartItem {
  id              String      @id @default(cuid())
  cartId          String
  productId       String
  quantity        Float
  qualityGrade    QualityGrade @default(A_STANDARD)
  priceAtAdd      Float       // snapshot of price when added
  createdAt       DateTime    @default(now())

  cart            Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, qualityGrade])
}

model WishlistItem {
  id          String    @id @default(cuid())
  customerId  String
  productId   String
  addedAt     DateTime  @default(now())

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique @default(cuid()) // human-readable: FRM-20250501-XXXX
  customerId          String
  farmerId            String
  addressId           String

  status              OrderStatus   @default(PENDING_PAYMENT)

  // Pricing
  subtotal            Float
  deliveryFee         Float         @default(0)
  packagingFee        Float         @default(0)
  discount            Float         @default(0)
  total               Float

  // Payment
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       PaymentMethod?
  razorpayOrderId     String?
  razorpayPaymentId   String?

  // Delivery
  deliveryType        DeliveryType  @default(NEXT_DAY)
  scheduledDate       DateTime?
  scheduledSlot       String?       // 'morning_6_9', 'morning_9_12', 'evening_4_7'
  estimatedDelivery   DateTime?
  deliveredAt         DateTime?
  deliveryPartnerId   String?
  trackingCode        String?

  // Farmer handling
  farmerAcceptedAt    DateTime?
  farmerRejectedAt    DateTime?
  farmerRejectionReason String?
  readyForPickupAt    DateTime?

  // Metadata
  couponCode          String?
  specialInstructions String?
  cancellationReason  String?
  cancelledBy         String?       // 'customer', 'farmer', 'admin', 'system'
  cancelledAt         DateTime?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer            Customer      @relation(fields: [customerId], references: [id])
  farmer              Farmer        @relation("FarmerOrders", fields: [farmerId], references: [id])
  address             Address       @relation(fields: [addressId], references: [id])
  deliveryPartner     DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  review              FarmerReview?
  dispute             Dispute?
  refund              Refund?
  payout              Payout?       @relation("OrderPayout")

  @@index([customerId, status])
  @@index([farmerId, status])
  @@index([orderNumber])
  @@index([status, scheduledDate])
}

model OrderItem {
  id              String        @id @default(cuid())
  orderId         String
  productId       String
  productName     String        // snapshot (in case product changes)
  productUnit     ProductUnit
  qualityGrade    QualityGrade
  quantity        Float
  unitPrice       Float         // price at time of order
  totalPrice      Float

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?
  changedBy   String?     // userId
  changedAt   DateTime    @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

// ─── SUBSCRIPTIONS ───────────────────────────────────────────────────────────

model Subscription {
  id                  String                @id @default(cuid())
  customerId          String
  name                String?               // "Weekly Veggie Box", custom name
  frequency           SubscriptionFrequency
  status              SubscriptionStatus    @default(ACTIVE)

  addressId           String
  deliverySlot        String                // preferred delivery slot

  // Billing
  totalPerDelivery    Float
  paymentMethodToken  String?               // Razorpay recurring token
  nextBillingDate     DateTime
  nextDeliveryDate    DateTime

  // Pause / cancellation
  pausedUntil         DateTime?
  pauseReason         String?
  cancelledAt         DateTime?
  cancellationReason  String?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  customer            Customer              @relation(fields: [customerId], references: [id])
  items               SubscriptionItem[]
  deliveries          SubscriptionDelivery[]
}

model SubscriptionItem {
  id              String        @id @default(cuid())
  subscriptionId  String
  productId       String
  quantity        Float
  qualityGrade    QualityGrade  @default(A_STANDARD)
  unitPrice       Float

  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

model SubscriptionDelivery {
  id              String      @id @default(cuid())
  subscriptionId  String
  orderId         String?     // linked order when created
  scheduledDate   DateTime
  status          String      @default("scheduled") // scheduled, delivered, skipped, failed
  skippedReason   String?
  createdAt       DateTime    @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
}

// ─── DELIVERY ────────────────────────────────────────────────────────────────

model DeliveryPartner {
  id              String    @id @default(cuid())
  userId          String    @unique
  name            String
  phone           String
  vehicleType     String    // 'bike', 'cycle', 'auto', 'van'
  vehicleNumber   String?
  aadharVerified  Boolean   @default(false)
  isActive        Boolean   @default(true)
  currentLat      Float?
  currentLng      Float?
  locationUpdatedAt DateTime?
  serviceablePincodes String[]
  totalDeliveries Int       @default(0)
  avgRating       Float?

  user            User      @relation(fields: [userId], references: [id])
  orders          Order[]
  deliveryZones   DeliveryZone[]
}

model DeliveryZone {
  id              String    @id @default(cuid())
  name            String    // 'Noida Sector 15-30'
  pincodes        String[]
  isServiceable   Boolean   @default(true)
  deliveryFee     Float     @default(0)
  freeDeliveryAbove Float?
  expressCutoffTime String? // '11:00' — orders before this get same-day
  nextDayCutoffTime String? // '20:00'
  deliveryPartners DeliveryPartner[]
  createdAt       DateTime  @default(now())
}

// ─── PAYMENTS & PAYOUTS ──────────────────────────────────────────────────────

model Payment {
  id                  String        @id @default(cuid())
  orderId             String        @unique
  customerId          String
  amount              Float
  currency            String        @default("INR")
  status              PaymentStatus
  method              PaymentMethod?

  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?

  failureReason       String?
  refundedAmount      Float         @default(0)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([customerId])
  @@index([razorpayPaymentId])
}

model Payout {
  id                  String        @id @default(cuid())
  farmerId            String
  orderId             String?       @unique
  type                String        // 'order_settlement', 'refund_deduction', 'weekly_batch'

  grossAmount         Float         // what customer paid
  farmerCommission    Float         // % Farmy keeps
  commissionAmount    Float
  netAmount           Float         // what farmer gets

  status              PayoutStatus  @default(PENDING)
  scheduledFor        DateTime      // usually 2 days after delivery
  processedAt         DateTime?

  razorpayPayoutId    String?
  utr                 String?       // bank UTR on success
  failureReason       String?

  createdAt           DateTime      @default(now())

  farmer              Farmer        @relation(fields: [farmerId], references: [id])
  order               Order?        @relation("OrderPayout", fields: [orderId], references: [id])

  @@index([farmerId, status])
  @@index([scheduledFor, status])
}

// ─── COUPONS & PROMOTIONS ────────────────────────────────────────────────────

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  type            String    // 'percent', 'flat', 'free_delivery'
  value           Float     // percent or flat amount
  minOrderValue   Float?
  maxDiscount     Float?    // cap on percentage discounts
  usageLimit      Int?      // total uses allowed
  usageCount      Int       @default(0)
  perUserLimit    Int       @default(1)
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean   @default(true)
  applicableTo    String    // 'all', 'new_customers', 'specific_farmers', 'specific_categories'
  applicableIds   String[]  // farmer IDs or category IDs

  usages          CouponUsage[]
  createdAt       DateTime  @default(now())
}

model CouponUsage {
  id          String    @id @default(cuid())
  couponId    String
  customerId  String
  orderId     String
  discount    Float
  usedAt      DateTime  @default(now())

  coupon      Coupon    @relation(fields: [couponId], references: [id])
  @@unique([couponId, customerId, orderId])
}

model FlashSale {
  id              String    @id @default(cuid())
  title           String    // "Morning Fresh Deal"
  description     String?
  startTime       DateTime
  endTime         DateTime
  discountPercent Float
  productIds      String[]  // products included
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

// ─── DISPUTES & QUALITY ──────────────────────────────────────────────────────

model Dispute {
  id              String        @id @default(cuid())
  orderId         String        @unique
  customerId      String
  farmerId        String
  reason          String        // 'wrong_item', 'quality_issue', 'short_quantity', 'not_delivered', 'damaged'
  description     String
  photos          String[]
  status          DisputeStatus @default(OPEN)

  adminNote       String?
  resolution      String?
  resolvedBy      String?       // admin userId
  resolvedAt      DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id])
  refund          Refund?
}

model Refund {
  id              String    @id @default(cuid())
  orderId         String    @unique
  disputeId       String?   @unique
  customerId      String
  amount          Float
  type            String    // 'full', 'partial'
  reason          String
  status          String    @default("initiated") // initiated, processing, completed, failed
  razorpayRefundId String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  order           Order     @relation(fields: [orderId], references: [id])
  dispute         Dispute?  @relation(fields: [disputeId], references: [id])
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String    // 'order_confirmed', 'order_delivered', 'payout_processed', etc.
  title       String
  body        String
  imageUrl    String?
  deepLink    String?   // '/orders/ORD-123'
  isRead      Boolean   @default(false)
  readAt      DateTime?
  metadata    Json?
  sentAt      DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}

model WhatsappLog {
  id              String    @id @default(cuid())
  phone           String
  direction       String    // 'outbound', 'inbound'
  messageType     String    // 'order_alert', 'payout_alert', 'otp', 'marketing'
  templateName    String?
  body            String?
  status          String    @default("sent")
  waMsgId         String?
  relatedId       String?   // orderId, payoutId etc.
  createdAt       DateTime  @default(now())
}

// ─── ADMIN & PLATFORM ────────────────────────────────────────────────────────

model PlatformConfig {
  id              String    @id @default(cuid())
  key             String    @unique
  value           String
  description     String?
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  action      String    // 'farmer_verified', 'order_cancelled', 'payout_processed'
  resource    String
  resourceId  String?
  oldValue    Json?
  newValue    Json?
  ip          String?
  createdAt   DateTime  @default(now())
  @@index([userId])
  @@index([resource, resourceId])
}

model BannerContent {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  ctaText     String?
  ctaLink     String?
  placement   String    // 'home_hero', 'home_banner', 'category_top'
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
}
